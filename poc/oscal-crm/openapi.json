{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic OSCAL CRM API",
    "version": "0.1.0",
    "description": "Read-only local proof of concept. Declarations are not assessment results or authorization decisions."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "Synthetic loopback development only; use approved TLS termination before any network exposure."
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "responses": {
      "Success": {
        "description": "Synthetic JSON context",
        "content": { "application/json": { "schema": { "type": "object" } } }
      },
      "Unauthorized": { "description": "Missing or invalid bearer token" },
      "NotFound": { "description": "Unknown context or instance outside authorized tenant" }
    }
  },
  "paths": {
    "/api/crm/compare/{from}/{to}": {
      "get": {
        "summary": "Compare synthetic plan declarations, not assessed compliance",
        "parameters": [
          {
            "name": "from",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          },
          {
            "name": "to",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v2/catalog": {
      "get": {
        "summary": "Mock OSBAPI discovery, not a provision-capable broker",
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/v2/service_instances/{instance_id}": {
      "put": {
        "summary": "Local mock-only synthetic provision; not a registered service broker",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "description": "Invalid synthetic service or plan" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "description": "Conflicting synthetic instance" }
        }
      },
      "delete": {
        "summary": "Local mock-only synthetic deprovision",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v2/service_instances/{instance_id}/last_operation": {
      "get": {
        "summary": "Local mock-only synthetic operation state",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v2/service_instances/{instance_id}/service_bindings/{binding_id}": {
      "put": {
        "summary": "Local mock-only binding that returns a non-secret synthetic account reference",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "binding_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "201": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "description": "Conflicting binding or unavailable account" }
        }
      },
      "delete": {
        "summary": "Local mock-only synthetic unbind",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "binding_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/mock/service-instances/{instance_id}/accounts": {
      "post": {
        "summary": "Create an in-memory synthetic demo account; never a real identity",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "201": { "$ref": "#/components/responses/Success" },
          "400": { "description": "Invalid demo label" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/mock/service-instances/{instance_id}/accounts/{account_id}": {
      "get": {
        "summary": "Read an in-memory synthetic demo account",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/mock/service-instances/{instance_id}/accounts/{account_id}/disable": {
      "post": {
        "summary": "Disable an in-memory synthetic account and prevent future bindings",
        "parameters": [
          { "name": "instance_id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "account_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/crm/offerings/{offering}/plans/{plan}": {
      "get": {
        "parameters": [
          {
            "name": "offering",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          },
          {
            "name": "plan",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/crm/instances/{instance}": {
      "get": {
        "parameters": [
          {
            "name": "instance",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          },
          {
            "name": "X-CRM-Tenant",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "enum": ["demo-tenant"] }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/components/{uuid}": {
      "get": {
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/oscal/{model}": {
      "get": {
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/notes/component-model": {
      "get": {
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "responses": {
          "200": { "$ref": "#/components/responses/Success" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  }
}
