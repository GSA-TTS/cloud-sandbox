{
  "servers": {
    "aws-api": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@1.6.3",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ]
    },
    "gcloud": {
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp"
      ]
    },
    "azure-resource-manager": {
      "type": "http",
      "url": "https://mcp.management.azure.com"
    },
    "databricks": {
      "command": "uvx",
      "args": [
        "databricks-mcp"
      ]
    }
  }
}